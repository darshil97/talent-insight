# backend/app/config.yaml holds committed non-secret defaults.
# This ignored backend/.env supplies secrets and optional overrides.
# Explicit settings > process environment > this file > config.yaml.
# Empty values use the next available source. Restart after changes.
# DOCS_ENABLED=false
# JSON array of exact origins, with no paths, credentials, queries or wildcards.
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Remote origins must use HTTPS; loopback origins may use HTTP.
# With no configured origins, cross-origin access is disabled.

# Existing Neon project: talent-insight. Local and hosted runs use the same database.
# Uncomment and replace these placeholders in backend/.env, never in frontend.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Both URLs address the same database. The direct URL is for migrations.
# Both must be configured with the same Neon values on the backend host at deployment.
# There is one app configuration; remove APP_ENV from older local files.
# PDF upload limits and other non-secret defaults are in app/config.yaml.
# Files/text are temporary and never stored.

# Structured extraction is disabled unless AI_MODE is explicitly set.
# Use mock for labeled offline literal-skill examples, or bedrock for paid AI requests.
# AI_MODE=mock
# Select and verify your account's model and region; no application default is assumed.
# AWS_REGION=YOUR_AWS_REGION
# BEDROCK_MODEL_ID=YOUR_VERIFIED_MODEL_OR_INFERENCE_PROFILE_ID
# AWS_BEARER_TOKEN_BEDROCK=YOUR_PRIVATE_BEDROCK_API_KEY
# Alternatively use the AWS SDK credential chain (server-side only):
# AWS_PROFILE=YOUR_LOCAL_PROFILE
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_TEMPORARY_SESSION_TOKEN
# Optional generation and logging overrides (defaults in app/config.yaml):
# AI_TEMPERATURE=0
# BEDROCK_REASONING_EFFORT=low
# LOG_LEVEL=INFO
# Requirement credit for comparable and partial evidence (met is 1):
# MATCH_CREDIT_TRANSFERABLE=0.75
# MATCH_CREDIT_PARTIAL=0.5
# Availability ranking bonus as [max days to join, bonus] pairs:
# RANKING_AVAILABILITY_TIERS=[[15,5],[30,4],[45,3],[60,2],[90,1]]
# For limit or weight overrides, use the matching uppercase names from app/config.py.
# Matching weights must be integers totaling 100.

# Voice screening is disabled unless VOICE_MODE is explicitly set; it also needs AI_MODE.
# Use mock for an offline token and scripted interviewer, or deepgram for paid voice sessions.
# VOICE_MODE=mock
# Public HTTPS origin of this backend that Deepgram calls for interviewer turns.
# Loopback HTTP is accepted for mock mode only.
# VOICE_PUBLIC_API_URL=https://YOUR_PUBLIC_BACKEND_HOST
# Random value of at least 32 characters that signs upload screening context.
# SESSION_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
# Server-side Deepgram key with Member permissions; only short-lived tokens reach browsers.
# DEEPGRAM_API_KEY=YOUR_PRIVATE_DEEPGRAM_API_KEY
# Optional interviewer model and region; unset values reuse BEDROCK_MODEL_ID and AWS_REGION.
# A low-latency model matters for voice; verify account access before selecting one.
# VOICE_BEDROCK_MODEL_ID=YOUR_VERIFIED_LOW_LATENCY_MODEL_OR_PROFILE_ID
# VOICE_AWS_REGION=YOUR_AWS_REGION
# Cloudflare Turnstile bot check before a screening starts; off unless both keys are set.
# Create a widget for your frontend hostname; the site key is public, the secret is private.
# TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY=YOUR_PRIVATE_TURNSTILE_SECRET_KEY
# Usage rows on Neon are written whenever DATABASE_URL is set; USAGE_RECORDING=false stops them.
# Prices: [[MODEL_ID, USD per million input tokens, USD per million output tokens], ...]
# USAGE_TOKEN_PRICES=[["YOUR_MODEL_ID", 0, 0]]
# USAGE_DEEPGRAM_MINUTE_PRICE=YOUR_PER_MINUTE_PRICE
# Optional per-process screening limits (defaults in app/config.yaml):
# VOICE_SESSIONS_PER_HOUR=6
# VOICE_SESSIONS_PER_DAY=20
# Optional regional endpoints, for example the India region:
# VOICE_AGENT_URL=wss://api.in.deepgram.com/v1/agent/converse
# VOICE_API_URL=https://api.in.deepgram.com
