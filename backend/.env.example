# Loaded from backend/.env, independently of the command's working directory.
# Process environment variables override this file. Restart after changes.
DOCS_ENABLED=true
# JSON array of exact origins, with no paths, credentials, queries or wildcards.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Remote origins must use HTTPS; loopback origins may use HTTP.
# With no configured origins, cross-origin access is disabled.

# Existing Neon project: talent-insight. Local and hosted runs use the same database.
# Uncomment and replace these placeholders in backend/.env, never in frontend.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Both URLs address the same database. The direct URL is for migrations.
# Both must be configured with the same Neon values on the backend host at deployment.
# There is one app configuration; remove APP_ENV from older local files.
# PDF upload limits (optional; defaults shown). Files/text are temporary and never stored.
# RESUME_MAX_BYTES=5242880
# RESUME_MAX_PAGES=20
# RESUME_MAX_CHARACTERS=100000
# RESUME_UPLOAD_TIMEOUT_SECONDS=15
# RESUME_TIMEOUT_SECONDS=10
# RESUME_MAX_CONCURRENT=2

# Structured extraction is disabled unless AI_MODE is explicitly set.
# Use mock for labeled offline literal-skill examples, or bedrock for paid AI requests.
# AI_MODE=mock
# Select and verify your account's model and region; no application default is assumed.
# AWS_REGION=YOUR_AWS_REGION
# BEDROCK_MODEL_ID=YOUR_VERIFIED_MODEL_OR_INFERENCE_PROFILE_ID
# AWS_BEARER_TOKEN_BEDROCK=YOUR_PRIVATE_BEDROCK_API_KEY
# Alternatively use the AWS SDK credential chain (server-side only):
# AWS_PROFILE=YOUR_LOCAL_PROFILE
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_TEMPORARY_SESSION_TOKEN
# BEDROCK_STRUCTURED_METHOD=json_schema
# AI_MAX_INPUT_CHARACTERS=20000
# AI_MAX_OUTPUT_TOKENS=3000
# AI_TIMEOUT_SECONDS=45
# AI_MAX_ATTEMPTS=2
# AI_MAX_CONCURRENT=1
# AI_REQUESTS_PER_MINUTE=5
